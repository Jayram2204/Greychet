# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets. This file only holds placeholders.

# --- Monad Testnet (chain ID 10143) — primary target for this hackathon ---
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/
NEXT_PUBLIC_MONAD_TESTNET_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_TESTNET_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Monad Mainnet (chain ID 143) — STRETCH GOAL ONLY, not used until told ---
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_MAINNET_CHAIN_ID=143

# --- Deployer key (Foundry) ---
# DO NOT COMMIT REAL VALUE. Use a throwaway testnet-only wallet, never a wallet
# holding real funds. Prefer `cast wallet import` + --account over pasting a raw
# key here; this var is a fallback for scripts that require it.
DEPLOYER_PRIVATE_KEY=0xDO_NOT_COMMIT_REAL_VALUE

# --- Deployed contract address ---
# The actual deployed CachetRegistry address lives in packages/shared/addresses.ts
# (single source of truth, keyed by chain ID) — nothing to set here.

# --- Registrar wallet connection (Privy embedded wallets) ---
# Create an app at https://dashboard.privy.io to get these. Both are meant to be
# client-exposed (NEXT_PUBLIC_), not secrets — do not confuse with a Privy App
# Secret, which would be a real secret and must never go in this file either.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
